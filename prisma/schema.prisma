// Prisma schema for CREJ Staff Portal
// SQLite for dev, Postgres for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  roles                 UserRole[]
  trainingCompletions   TrainingCompletion[]
  checklistInstances    ChecklistInstance[]
  auditLogs             AuditLog[]           @relation("Actor")
  contentEdits          ContentItem[]        @relation("Editor")

  @@index([email])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String   // ADMIN, DSPD_SUPPORT_COORDINATOR, DSPD_MANAGER, HRSS_STAFF, EPAS_STAFF, DSP, TRAINER
  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
}

model ContentItem {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  summary     String?
  content     String   // Markdown content
  category    String   // ONBOARDING, SOPS, TRAININGS, COMPLIANCE_CHECKLISTS, REFERENCE
  program     String   // DSPD, HRSS, EPAS
  filePath    String?  // Path to source file if from /content folder
  isFromFile  Boolean  @default(false) // True if ingested from file system
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  editorId    String?

  // Relations
  editor      User?           @relation("Editor", fields: [editorId], references: [id], onDelete: SetNull)
  trainings   Training[]      @relation("ContentItem")
  checklistItems ChecklistItem[] @relation("ContentItem")

  @@index([program, category])
  @@index([slug])
  @@index([isFromFile])
}

model Training {
  id          String   @id @default(cuid())
  title       String
  description String?
  contentItemId String? // If linked to content item
  videoUrl    String?  // External video URL
  documentUrl String? // External document URL
  program     String   // DSPD, HRSS, EPAS
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  contentItem ContentItem? @relation("ContentItem", fields: [contentItemId], references: [id], onDelete: SetNull)
  completions TrainingCompletion[]
  requirements TrainingRequirement[]

  @@index([program])
  @@index([contentItemId])
}

model TrainingRequirement {
  id        String   @id @default(cuid())
  trainingId String
  role      String   // UserRole string
  createdAt DateTime @default(now())

  // Relations
  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, role])
  @@index([trainingId])
  @@index([role])
}

model TrainingCompletion {
  id          String   @id @default(cuid())
  userId      String
  trainingId  String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // Relations
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  training  Training  @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([userId, trainingId])
  @@index([userId])
  @@index([trainingId])
  @@index([completedAt])
}

model Checklist {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // NEW_CLIENT, NEW_ISO, MONTHLY_NOTES_AUDIT, INCIDENT_REPORTING, TIMESHEET_BILLING, MONTHLY_REMINDERS, REQUIRED_FORMS, CUSTOM
  program     String   // DSPD, HRSS, EPAS
  items       ChecklistItem[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  instances   ChecklistInstance[]

  @@index([program, type])
}

model ChecklistItem {
  id          String   @id @default(cuid())
  checklistId String
  title       String
  description String?  // Step-by-step instructions
  contentItemId String? // Link to SOP/content
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  checklist   Checklist  @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  contentItem ContentItem? @relation("ContentItem", fields: [contentItemId], references: [id], onDelete: SetNull)
  completions ChecklistItemCompletion[]

  @@index([checklistId])
  @@index([order])
}

model ChecklistInstance {
  id          String   @id @default(cuid())
  checklistId String
  userId      String
  label       String   // User-entered label (e.g., "Case #1") - NO PHI
  notes       String?  // Optional notes - NO PHI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemCompletions ChecklistItemCompletion[]

  @@index([userId])
  @@index([checklistId])
}

model ChecklistItemCompletion {
  id                String   @id @default(cuid())
  checklistItemId   String
  checklistInstanceId String
  completedAt       DateTime @default(now())
  notes             String?  // Optional completion notes - NO PHI

  // Relations
  checklistItem     ChecklistItem     @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  checklistInstance ChecklistInstance @relation(fields: [checklistInstanceId], references: [id], onDelete: Cascade)

  @@unique([checklistItemId, checklistInstanceId])
  @@index([checklistInstanceId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String   // e.g., "LOGIN", "CONTENT_EDITED", "TRAINING_COMPLETED"
  entityType  String   // e.g., "User", "ContentItem", "Training"
  entityId    String?
  metadata    String?  // JSON string with additional context
  createdAt   DateTime @default(now())

  // Relations
  actor       User?    @relation("Actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([entityType])
}

model MagicLinkToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([expiresAt])
}
